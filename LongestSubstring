    def lengthOfLongestSubstring(self, s):
        """
        :type s: str
        :rtype: int
        """
        curr = 0 
        length =0
        longlength =0
        a = list(s) 
        CurrAns = ""
        ans = ""
        start =0 
        while curr < len(a): # while there is still characters left 
            if a[curr] in CurrAns: # is in alr 
                length =1
                start +=1 
                curr = start
                CurrAns = a[start]
            else: # is not in the current ans already
                CurrAns += a[curr]
                length += 1

            #if current lenth > the old one 
            if length >= longlength: 
                ans = CurrAns
                longlength = length
            curr+=1
        return longlength


            
        
