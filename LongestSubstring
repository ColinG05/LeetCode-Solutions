class Solution(object):
    def lengthOfLongestSubstring(self, s):
        """
        :type s: str
        :rtype: int
        """
        curr = 0 
        length = 0
        longlength = 0
        output = ''
        a = list(s) 
        
        left = 0
        right = 0

        while right < len(a): 

            if a[right] not in output:
                output += a[right]
                right += 1
                length += 1

            else:
                output = output[1:]
                left += 1
                length -= 1

            if length > longlength: 
                longlength = length

        return longlength
